# Environment Mode (development / production)
# In production or on Cloud Run (K_SERVICE), local .env is not force-loaded
ENVIRONMENT=development

# Structured Logging Configuration (Twelve-Factor App Factor XI)
LOG_LEVEL=INFO
# Format Options: "text" (human readable for dev) or "json" (GCP Cloud Logging for prod)
LOG_FORMAT=text

# ── Local LLM & Embedding (Lightning AI / Ollama Proxy) ───────────
# Set to "true" to use self-hosted Qwen3 on Lightning AI T4 GPU as primary provider
USE_LOCAL_LLM=true
# Base URL of the Lightning AI public proxy (or local Ollama: http://localhost:11434)
OLLAMA_BASE_URL=https://8000-YOUR-STUDIO-ID.cloudspaces.litng.ai
# Secret Bearer Token for the LitServe / FastAPI reverse proxy
OLLAMA_API_KEY=segula-super-secret-key-2026
# Model tags in Ollama
LOCAL_MODEL=ollama/qwen3:8b
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b

# ── Cloud LLM Providers (Automatic Fallback & Safety Net) ──────────
# Google Gemini API Keys (primary cloud / rotation fallback)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
# OpenAI API Key (secondary cloud fallback)
OPENAI_API_KEY=

# ── LLM Models & Parameters ───────────────────────────────────────
PRIMARY_MODEL=gemini/gemini-3.1-flash-lite
FALLBACK_MODEL=openai/gpt-4o
LLM_TEMPERATURE=0
LLM_TEMPERATURE_CLARIFICATION=0.3

# ── Scoring Thresholds ───────────────────────────────────────────
SCORE_GO_THRESHOLD=70
SCORE_NOGO_THRESHOLD=20
MAX_CLARIFICATION_ROUNDS=2

# ── RAG & Embedding Settings ─────────────────────────────────────
RAG_EXACT_MATCH_THRESHOLD=0.75
RAG_SIMILAR_THRESHOLD=0.60
RAG_TOP_K=5
# 1024 for qwen3-embedding:0.6b, 768 for gemini text-embedding-004
EMBEDDING_DIMENSION=1024

# ── PostgreSQL Database (asyncpg driver required) ─────────────────
# Local TCP (Docker compose default port 5435):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5435/requirementshub

# GCP Cloud SQL Unix Socket (Cloud Run Production):
# DATABASE_URL=postgresql+asyncpg://user:password@/requirementshub?host=/cloudsql/PROJECT:REGION:INSTANCE
# Or via individual Cloud SQL variables:
# INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE
# DB_USER=postgres
# DB_PASS=secret
# DB_NAME=requirementshub

# ── Database Connection Pool (Cloud SQL / Cloud Run Scaling) ──────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
