# =====================================================================
# Segula AI Requirement Hub — Sovereign Environment Configuration
# =====================================================================
# Copy this file to '.env' and paste your Lightning AI Studio public URL.

# ── Environment Mode & Logging ───────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Sovereign AI Backend Selection ────────────────────────────────────
# The Segula AI Requirement Hub uses 100% Sovereign Self-Hosted AI:
# - DeepSeek-R1 (14B AWQ) served via vLLM with xgrammar guided decoding
# - Qwen3-Embedding (0.6B / 1024-dim) served via Ollama
LLM_BACKEND=lightning_vllm
LLM_FALLBACK_BACKEND=none

# ── ⚡ Lightning AI Sovereign GPU Gateway (Port 8000 Proxy) ───────────
# Replace 'YOUR-STUDIO-ID' with your active Lightning AI Studio identifier.
# NOTE: VLLM_BASE_URL MUST end with '/v1' (OpenAI-compatible wire protocol).
VLLM_BASE_URL=https://8000-YOUR-STUDIO-ID.cloudspaces.litng.ai/v1
VLLM_API_KEY=segula-super-secret-key-2026
VLLM_MODEL=casperhansen/deepseek-r1-distill-qwen-14b-awq

# Grammar-constrained JSON decoding (guarantees valid Pydantic extraction)
VLLM_USE_GUIDED_JSON=true
VLLM_GUIDED_BACKEND=xgrammar

# Embeddings Gateway (Ollama protocol /api/embed)
OLLAMA_BASE_URL=https://8000-YOUR-STUDIO-ID.cloudspaces.litng.ai
OLLAMA_API_KEY=segula-super-secret-key-2026
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024

# ── LLM Hyperparameters & Timeouts ───────────────────────────────────
LLM_TEMPERATURE=0
LLM_TEMPERATURE_CLARIFICATION=0.3
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_HEALTHCHECK_TIMEOUT_SECONDS=5

# ── 5-Pillar Scoring & RAG Thresholds ────────────────────────────────
SCORE_GO_THRESHOLD=70
SCORE_NOGO_THRESHOLD=20
MAX_CLARIFICATION_ROUNDS=2
RAG_EXACT_MATCH_THRESHOLD=0.75
RAG_SIMILAR_THRESHOLD=0.50
RAG_TOP_K=5

# ── PostgreSQL Database (asyncpg driver required) ────────────────────
# Local Docker Compose defaults:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5435/requirementshub

# GCP Cloud SQL Production (Optional):
# DATABASE_URL=postgresql+asyncpg://user:password@/requirementshub?host=/cloudsql/PROJECT:REGION:INSTANCE
# INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE

# ── Database Connection Pool Settings ─────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
