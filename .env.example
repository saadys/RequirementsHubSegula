# =====================================================================
# Segula AI Requirement Hub — Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and update the values according to your setup.

# ── Environment Mode (development / production) ──────────────────────
ENVIRONMENT=development

# ── Structured Logging Configuration ─────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── Local LLM & Embedding (Lightning AI / Ollama Proxy) ──────────────
# Set to 'true' to use self-hosted DeepSeek-R1 / Qwen on Lightning AI GPU
USE_LOCAL_LLM=true

# 1. Base URL: Paste your Lightning AI Studio public port 8000 URL here
# Example: https://8000-01m03qzk5mcssvw8pk45ke8839.cloudspaces.litng.ai
OLLAMA_BASE_URL=https://8000-YOUR-STUDIO-ID.cloudspaces.litng.ai

# 2. Bearer Authentication Token (must match SECRET_TOKEN in proxy_server.py)
OLLAMA_API_KEY=segula-super-secret-key-2026

# 3. Model Tags loaded in your remote Ollama instance
LOCAL_MODEL=ollama/deepseek-r1:14b
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b

# ── Cloud LLM Providers (Automatic Fallback & Backup) ────────────────
# Google Gemini API Keys (optional fallback if local GPU goes offline)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# OpenAI API Key (optional secondary fallback)
OPENAI_API_KEY=

# ── Primary & Fallback LLM Parameters ────────────────────────────────
PRIMARY_MODEL=gemini/gemini-3.1-flash-lite
FALLBACK_MODEL=openai/gpt-4o
LLM_TEMPERATURE=0
LLM_TEMPERATURE_CLARIFICATION=0.3

# ── 5-Pillar Scoring Thresholds ──────────────────────────────────────
SCORE_GO_THRESHOLD=70
SCORE_NOGO_THRESHOLD=20
MAX_CLARIFICATION_ROUNDS=2

# ── RAG & Embedding Settings ─────────────────────────────────────────
RAG_EXACT_MATCH_THRESHOLD=0.83
RAG_SIMILAR_THRESHOLD=0.80
RAG_TOP_K=5
# 1024 for qwen3-embedding:0.6b, 768 for gemini-embedding-2 / text-embedding-004
EMBEDDING_DIMENSION=1024

# ── PostgreSQL Database (asyncpg driver required) ────────────────────
# Local TCP (Docker compose default port 5435):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5435/requirementshub

# GCP Cloud SQL Unix Socket (Cloud Run Production):
# DATABASE_URL=postgresql+asyncpg://user:password@/requirementshub?host=/cloudsql/PROJECT:REGION:INSTANCE
# INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE
# DB_USER=postgres
# DB_PASS=secret
# DB_NAME=requirementshub

# ── Database Connection Pool ─────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
