# =====================================================================
# Segula AI Requirement Hub — Environment Configuration Template
# =====================================================================
# Copy this file to '.env' and update the values according to your setup.

# ── Environment Mode (development / production) ──────────────────────
ENVIRONMENT=development

# ── Structured Logging Configuration ─────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=text

# ── LLM Backend Selection ────────────────────────────────────────────
# Names the execution target explicitly. One of:
#   ollama_local    → native Ollama protocol  (/api/chat)  — laptop / on-prem
#   lightning_vllm  → OpenAI-compatible /v1   — vLLM on a Lightning AI GPU
#   gemini_cloud    → Google Gemini           — managed cloud
#   openai_cloud    → OpenAI GPT              — managed cloud
LLM_BACKEND=lightning_vllm

# Automatic failover target when the primary times out, returns 5xx, or the
# remote GPU is asleep. Set to 'none' to disable and surface primary errors.
# Only availability failures trigger it: a malformed prompt or a schema
# violation is NOT retried elsewhere, since it would fail identically there.
LLM_FALLBACK_BACKEND=gemini_cloud

# ── Backend: lightning_vllm (OpenAI-compatible /v1) ──────────────────
# MUST end with /v1 — that is where vLLM serves the OpenAI API surface.
# Example: https://8000-01m03qzk5mcssvw8pk45ke8839.cloudspaces.litng.ai/v1
VLLM_BASE_URL=https://8000-YOUR-STUDIO-ID.cloudspaces.litng.ai/v1

# Bearer token: value passed to vLLM via --api-key (or SECRET_TOKEN of proxy_server.py)
VLLM_API_KEY=change-me

# Served model id, exactly as `GET /v1/models` reports it. No litellm prefix:
# an 'ollama/' prefix here routes to the wrong protocol and is rejected at boot.
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# Grammar-constrained JSON decoding (vLLM only) — makes invalid JSON
# unreachable at the token level. Auto-degrades to json_object mode on HTTP 400,
# so it is safe to leave on for non-vLLM OpenAI-compatible servers.
VLLM_USE_GUIDED_JSON=true
VLLM_GUIDED_BACKEND=xgrammar

# ── Backend: ollama_local (native Ollama protocol) ───────────────────
# No /v1 suffix here — that is the OpenAI surface, served by lightning_vllm.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/qwen2.5:7b-instruct

# ── Deprecated ───────────────────────────────────────────────────────
# USE_LOCAL_LLM is superseded by LLM_BACKEND and is only consulted when
# LLM_BACKEND is unset (true → ollama_local, false → gemini_cloud).
# USE_LOCAL_LLM=false

# Bearer token, only if the Ollama instance sits behind an authenticating proxy.
# Leave empty for a plain local instance.
OLLAMA_API_KEY=

# Embedding model served by the self-hosted backend.
# Keep EMBEDDING_DIMENSION below consistent with it.
LOCAL_EMBEDDING_MODEL=nomic-embed-text

# ── Cloud LLM Providers (Automatic Fallback & Backup) ────────────────
# Google Gemini API Keys (optional fallback if local GPU goes offline)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# OpenAI API Key (optional secondary fallback)
OPENAI_API_KEY=

# ── Cloud Model Ids (used by gemini_cloud / openai_cloud backends) ───
PRIMARY_MODEL=gemini/gemini-2.5-flash
FALLBACK_MODEL=openai/gpt-4o

# ── LLM Tuning & Resilience ──────────────────────────────────────────
LLM_TEMPERATURE=0
LLM_TEMPERATURE_CLARIFICATION=0.3
# Retries for transient errors (rate limit, timeout, 5xx) before key rotation
# or a cross-provider fallback kicks in.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
# Remote GPU studios cold-start slowly; this default is generous on purpose.
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_HEALTHCHECK_TIMEOUT_SECONDS=5

# ── 5-Pillar Scoring Thresholds ──────────────────────────────────────
SCORE_GO_THRESHOLD=70
SCORE_NOGO_THRESHOLD=20
MAX_CLARIFICATION_ROUNDS=2

# ── RAG & Embedding Settings ─────────────────────────────────────────
# Dynamic defaults: Local model (0.75 / 0.50), Gemini cloud (0.82 / 0.70)
# Setting explicit values here overrides the automatic calibration.
RAG_EXACT_MATCH_THRESHOLD=0.75
RAG_SIMILAR_THRESHOLD=0.50
RAG_TOP_K=5
# Must match LOCAL_EMBEDDING_MODEL: 1024 for qwen3-embedding:0.6b, 768 for nomic-embed-text / text-embedding-004.
EMBEDDING_DIMENSION=1024

# ── PostgreSQL Database (asyncpg driver required) ────────────────────
# Local TCP (Docker compose default port 5435):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5435/requirementshub

# GCP Cloud SQL Unix Socket (Cloud Run Production):
# DATABASE_URL=postgresql+asyncpg://user:password@/requirementshub?host=/cloudsql/PROJECT:REGION:INSTANCE
# INSTANCE_CONNECTION_NAME=PROJECT:REGION:INSTANCE
# DB_USER=postgres
# DB_PASS=secret
# DB_NAME=requirementshub

# ── Database Connection Pool ─────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
